hathanhvi.vn {
    encode zstd gzip
    handle /api/* {
        reverse_proxy api:4000
    }
    handle /uploads/* {
        reverse_proxy api:4000
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

www.hathanhvi.vn {
    redir https://hathanhvi.vn{uri} permanent
}
