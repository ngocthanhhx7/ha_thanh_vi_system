hathanhvi.vn {
    encode zstd gzip
    handle /api/* {
        reverse_proxy api:4000
    }
    handle /uploads/* {
        reverse_proxy api:4000
    }
    handle /assets/* {
        root * /srv
        @exists file {path}
        header @exists Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle /brand/* {
        root * /srv
        @exists file {path}
        header @exists Cache-Control "public, max-age=604800"
        file_server
    }
    handle {
        root * /srv
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}

www.hathanhvi.vn {
    redir https://hathanhvi.vn{uri} permanent
}
