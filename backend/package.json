{
  "name": "@ha-thanh-vi/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "seed:demo": "tsx src/seedCustomerDemo.ts",
    "init:admin": "tsx src/initAdmin.ts",
    "init:admin:prod": "node dist/initAdmin.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongoose": "^8.19.0",
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.1.0",
    "zod": "^4.1.0",
    "dotenv": "^17.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/cors": "^2.8.19",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
